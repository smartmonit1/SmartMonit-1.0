# Copier ce fichier vers .env.local (et configurer les mêmes variables sur Vercel / Netlify / Firebase Hosting)
AI_PROVIDER=algorithmic

# Synchronisation Cloud temps réel multi-appareils (votre propre projet Firebase Spark gratuit)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=(default)

# Mistral credentials must be stored in a server-side secret manager.
# Do not add MISTRAL_API_KEY to this Vite client environment.
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL_FAST=mistral-small-latest
MISTRAL_MODEL_SMART=mistral-large-latest
MISTRAL_MODEL_VISION=pixtral-12b-2409
